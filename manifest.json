{
  "manifest_version": 3,
  "name": "Web Labels",
  "version": "1.1.0",
  "description": "Select page elements, add notes, and copy them as Markdown.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Web Labels",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  },
  "commands": {
    "toggle-annotate": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Toggle page annotations"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/i18n/strings.js",
        "src/content/lib.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  }
}
